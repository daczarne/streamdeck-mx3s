{
  "name": "com.daczarne.mx3s",
  "private": true,
  "description": "Elgato Stream Deck plugin that switches a Logitech MX Master 3S between its Easy-Switch hosts.",
  "license": "MIT",
  "author": "Daniel Czarnievicz",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/daczarne/streamdeck-mx3s.git"
  },
  "bugs": {
    "url": "https://github.com/daczarne/streamdeck-mx3s/issues"
  },
  "homepage": "https://github.com/daczarne/streamdeck-mx3s#readme",
  "keywords": [
    "streamdeck",
    "elgato",
    "logitech",
    "mx-master",
    "easy-switch"
  ],
  "scripts": {
    "build": "rollup -c",
    "check:ui": "node scripts/check-ui.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "watch": "rollup -c -w --watch.onEnd=\"streamdeck restart com.daczarne.mx3s\"",
    "link": "streamdeck link com.daczarne.mx3s.sdPlugin",
    "unlink": "streamdeck unlink com.daczarne.mx3s",
    "validate": "npm run check:ui && npm run build && streamdeck validate com.daczarne.mx3s.sdPlugin",
    "typecheck": "tsc --noEmit -p . && tsc -p tsconfig.scripts.json",
    "lint": "biome ci",
    "format": "biome check --write --linter-enabled=false"
  },
  "type": "module",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.22.1",
      "onFail": "error"
    },
    "packageManager": {
      "name": "npm",
      "version": "11.19.1",
      "onFail": "error"
    }
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@daczarne/streamdeck-icons": "github:daczarne/streamdeck-icons#061e62aad2245185cd018dd685f53fa772384a7b",
    "@elgato/cli": "1.10.2",
    "@rollup/plugin-commonjs": "29.0.3",
    "@rollup/plugin-node-resolve": "16.0.3",
    "@rollup/plugin-terser": "1.0.0",
    "@rollup/plugin-typescript": "12.3.0",
    "@tsconfig/node24": "24.0.5",
    "@types/node": "24.19.2",
    "rollup": "4.64.9",
    "sharp": "0.35.5",
    "tslib": "2.8.1",
    "typescript": "6.0.3"
  },
  "dependencies": {
    "@elgato/streamdeck": "3.0.3",
    "node-hid": "3.3.0"
  }
}

{
  "$schema": "https://schemas.elgato.com/streamdeck/plugins/manifest.json",
  "Name": "MX Master 3S",
  "Version": "0.1.1.0",
  "Author": "Daniel Czarnievicz",
  "Actions": [
    {
      "Name": "Set Host",
      "UUID": "com.daczarne.mx3s.set-host",
      "Icon": "imgs/actions/set-host/icon",
      "Tooltip": "Sends the mouse to one of its Easy-Switch hosts.",
      "PropertyInspectorPath": "ui/set-host.html",
      "Controllers": [
        "Keypad"
      ],
      "States": [
        {
          "Image": "imgs/actions/set-host/key",
          "ShowTitle": true,
          "TitleAlignment": "bottom",
          "FontSize": 14,
          "TitleColor": "#ffffff"
        }
      ]
    },
    {
      "Name": "Battery",
      "UUID": "com.daczarne.mx3s.battery",
      "Icon": "imgs/actions/battery/icon",
      "Tooltip": "Shows how much battery the mouse has left, and whether it's charging.",
      "PropertyInspectorPath": "ui/battery.html",
      "Controllers": [
        "Keypad"
      ],
      "States": [
        {
          "Image": "imgs/actions/battery/key",
          "ShowTitle": false
        }
      ]
    }
  ],
  "Category": "MX Master 3S",
  "CategoryIcon": "imgs/plugin/category-icon",
  "CodePath": "bin/plugin.js",
  "Description": "Switch a Logitech MX Master 3S between its Easy-Switch hosts from Stream Deck keys.",
  "Icon": "imgs/plugin/marketplace",
  "SDKVersion": 3,
  "Software": {
    "MinimumVersion": "7.1"
  },
  "OS": [
    {
      "Platform": "mac",
      "MinimumVersion": "12"
    },
    {
      "Platform": "windows",
      "MinimumVersion": "10"
    }
  ],
  "Nodejs": {
    "Version": "24"
  },
  "UUID": "com.daczarne.mx3s"
}
